# BakeConnect Environment Configuration Example

# Server & HTTP
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL 18
DB_PORT=5433
DB_NAME=bakeconnect_db
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/bakeconnect_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
DB_MAX_POOL_SIZE=50
DB_MIN_IDLE=10

# Redis Cache-Only
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail / SMTP (MailDev local dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Security & Tokens
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Payment Gateways (MOCK or YOUPI_PG)
PAYMENT_MODE=dev # dev or live
PAYMENT_PROVIDER=MOCK # MOCK or YOUPI_PG
YOUPI_PG_BASE_URL=http://localhost:7000
YOUPI_PG_MERCHANT_ID=00000000-0000-0000-0000-000000000001
YOUPI_PG_API_KEY=mock_api_key_for_youpi
YOUPI_PG_WEBHOOK_SECRET=mock_webhook_secret_32_bytes_long!
YOUPI_PG_CONNECT_TIMEOUT_MS=5000
YOUPI_PG_READ_TIMEOUT_MS=5000

# Outbox Worker
OUTBOX_POLL_RATE_MS=3000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRIES=5
